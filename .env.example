# Telegram
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
OWNER_TELEGRAM_ID=123456789
OWNER_CONTACT=@your_username

# Defaults
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_DAILY_PRICE=10
DEFAULT_SLEEP_TIME=23:00
REMINDER_HOURS_BEFORE_SLEEP=3
REMINDER_FALLBACK_TIME=20:45

# Paths inside the container
DB_PATH=/app/data/database.sqlite3
BACKUP_PATH=/app/backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14

# Jobs
BILLING_CHECK_MINUTES=15
REMINDER_CHECK_MINUTES=1

# Logging
LOG_LEVEL=INFO

# SOCKS5 for Telegram API (aiogram). Empty on hosts where Telegram is reachable.
# With docker-compose.override.yml (./generate-docker-override.sh) this is set automatically.
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
TELEGRAM_PROXY_URL=

# VPN / Bot API latency monitor (mihomo AUTO node + getMe RTT every 10s)
VPN_MONITOR_ENABLED=1
VPN_MONITOR_INTERVAL_SECONDS=10
VPN_MONITOR_TIMEOUT_SECONDS=8
MIHOMO_API_URL=http://127.0.0.1:9090
MIHOMO_API_SECRET=
MIHOMO_PROXY_GROUP=AUTO
VPN_LOG_DIR=/app/data/vpn
VPN_LOG_KEEP_DAYS=31
