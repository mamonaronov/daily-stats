# Telegram
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
OWNER_TELEGRAM_ID=123456789
OWNER_CONTACT=@your_username

# Defaults
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_DAILY_PRICE=3
DEFAULT_SLEEP_TIME=23:00

# Paths inside the container
DB_PATH=/app/data/database.sqlite3
BACKUP_PATH=/app/backups
BACKUP_INTERVAL_HOURS=1
BACKUP_KEEP=14
TELEGRAM_BACKUP_INTERVAL_MINUTES=30

# Jobs
BILLING_CHECK_MINUTES=15

# Logging
LOG_LEVEL=INFO

# SOCKS5 for Telegram API (socks5h = DNS through the proxy). Empty if Telegram is reachable directly.
# Docker + mihomo-proxy (сеть telegram-proxy): socks5h://proxy:11808
TELEGRAM_PROXY_URL=

# REST mihomo. Секрет — тот же, что MIHOMO_API_SECRET в .env mihomo-proxy.
# Docker: http://proxy:19090
MIHOMO_API_URL=
MIHOMO_API_SECRET=
MIHOMO_PROXY_GROUP=AUTO

# VPN / Bot API latency monitor (mihomo AUTO node + getMe RTT every 10s)
VPN_MONITOR_ENABLED=1
VPN_MONITOR_INTERVAL_SECONDS=10
VPN_MONITOR_TIMEOUT_SECONDS=8
# Separate sqlite for pings; not included in backups. Empty = next to DB_PATH as vpn.sqlite3
# VPN_DB_PATH=/app/data/vpn.sqlite3
VPN_LOG_KEEP_DAYS=31

# Separate sqlite for button-click analytics; not included in backups.
# CLICKS_DB_PATH=/app/data/clicks.sqlite3

# Separate sqlite for server load average; not included in backups.
# LOAD_DB_PATH=/app/data/load.sqlite3
# LOAD_LOG_KEEP_DAYS=31

# Owner alerts for joke/spam filling (user is never blocked automatically).
# Set a threshold to 0 to disable that check.
# SPAM_BUTTON_WINDOW_SECONDS=8
# SPAM_BUTTON_COUNT=20
# SPAM_WRITE_WINDOW_SECONDS=60
# SPAM_WRITE_COUNT=15
# SPAM_DAILY_ENTRIES=80
# SPAM_USER_ROWS=5000
# SPAM_ALERT_COOLDOWN_MINUTES=30
