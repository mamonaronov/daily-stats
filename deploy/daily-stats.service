#   sudo cp deploy/daily-stats.service /etc/systemd/system/daily-stats.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now daily-stats.service
#
# Edit WorkingDirectory if the repo lives elsewhere.

[Unit]
Description=Daily Stats Telegram bot
Requires=docker.service
Wants=mihomo.service network-online.target
After=docker.service network-online.target mihomo.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/aron/Документы/MyProjects/daily stats/repo/daily-stats
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
